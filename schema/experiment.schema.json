{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Experiment row (SRS 4.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "program", "platform", "phenomenon", "fuel_type", "fuel_category",
    "gravity_level", "o2_percent", "pressure_kpa", "flow_speed_cm_s", "flow_direction",
    "sample_geometry", "flame_behavior", "spread_class", "duration_seconds",
    "scoring_eligible", "takeaway", "source_url", "source_note", "verified_by"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{2}$" },
    "name": { "type": "string", "minLength": 1 },
    "program": { "enum": ["Saffire", "BASS", "FLEX", "ACME", "Earth reference"] },
    "platform": { "enum": ["Cygnus (after ISS)", "ISS Glovebox", "ISS Combustion Integrated Rack", "Earth lab", null] },
    "phenomenon": { "enum": ["Solid flame spread", "Droplet burning", "Gas diffusion flame", "Earth reference"] },
    "fuel_type": { "type": "string", "minLength": 1 },
    "fuel_category": { "enum": ["Solid", "Liquid", "Gas"] },
    "gravity_level": { "enum": ["Microgravity (0g)", "Earth (1g)"] },
    "o2_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "pressure_kpa": { "type": ["number", "null"], "minimum": 0 },
    "flow_speed_cm_s": { "type": ["number", "null"], "minimum": 0 },
    "flow_direction": { "enum": ["Concurrent", "Opposed", "None", null] },
    "sample_geometry": { "type": ["string", "null"] },
    "flame_behavior": { "type": ["string", "null"] },
    "spread_class": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "duration_seconds": { "type": ["number", "null"], "minimum": 0 },
    "scoring_eligible": { "type": "boolean" },
    "takeaway": { "type": ["string", "null"] },
    "source_url": { "type": "string", "pattern": "^https://" },
    "source_note": { "type": ["string", "null"] },
    "verified_by": { "type": ["string", "null"] },
    "hazard": { "type": ["object", "null"], "description": "Generated by the build script. Never edit by hand." }
  },
  "allOf": [
    {
      "if": { "properties": { "scoring_eligible": { "const": true } }, "required": ["scoring_eligible"] },
      "then": { "required": ["spread_class"], "properties": { "spread_class": { "type": "integer" } } },
      "else": { "properties": { "spread_class": { "type": "null" } } }
    }
  ]
}